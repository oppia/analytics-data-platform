[sqlfluff]
dialect = bigquery
templater = jinja
max_line_length = 120
# Exclude rules that conflict with common dbt + BigQuery/GA4 idioms:
#   AM04: SELECT * in upstream source CTEs
#   AM09: LIMIT 1 without ORDER BY in GA4 UNNEST(event_params) lookups
#   AL09: Explicit aliases when flattening BigQuery STRUCT fields (e.g., geo.country AS country)
#   LT14: Single-line inline UNNEST scalar subqueries
#   ST05: Inline scalar subqueries (GA4 UNNEST pattern)
#   ST06: Logical column ordering over strict simple-before-calculated ordering
exclude_rules = AM04, AM09, AL09, LT14, ST05, ST06

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:templater:jinja]
apply_dbt_builtins = True
load_macros_from_path = macros/

[sqlfluff:templater:jinja:macros]
# Backtick-quote source identifiers (matching dbt-bigquery) so GA4 wildcard tables (events_*) parse cleanly
dbt_source = {% macro source(source_name, table_name) %}`{{ source_name }}`.`{{ table_name }}`{% endmacro %}

[sqlfluff:layout:type:comma]
line_position = trailing

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower
# BigQuery pseudo-columns (_TABLE_SUFFIX, _PARTITIONDATE, _PARTITIONTIME) are conventionally uppercase
ignore_words = _TABLE_SUFFIX, _PARTITIONDATE, _PARTITIONTIME

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:layout.long_lines]
ignore_comment_lines = True
